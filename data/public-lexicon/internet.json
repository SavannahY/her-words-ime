    {"text": "太会了", "pinyin": "tai hui le", "category": "internet", "source_ids": ["internet-chat-mascot-2025"], "tags": ["praise"], "note": "夸表现、创意或安排很巧妙，很懂大家的喜好。"},
    {"text": "探店", "pinyin": "tan dian", "category": "internet", "source_ids": ["internet-mac-visit2024"], "tags": ["life", "creation"], "note": "实地体验店铺，并了解或分享其商品与服务。"},
    {"text": "网感", "pinyin": "wang gan", "category": "internet", "source_ids": ["internet-chat-drama-2025"], "tags": ["media"], "note": "熟悉网络语境、节奏或表达方式的感觉。"},
    {"text": "我裂开了", "pinyin": "wo lie kai le", "category": "internet", "source_ids": ["internet-chat-campus-2026"], "tags": ["reaction"], "note": "用夸张、自嘲语气描述一时无奈或不知所措。"},
    {"text": "我真的会谢", "pinyin": "wo zhen de hui xie", "category": "internet", "source_ids": ["internet-chat-campus-2026"], "tags": ["reaction"], "note": "聊天中夸张感叹或吐槽；不等同于正式致谢。"},
    {"text": "显眼包", "pinyin": "xian yan bao", "category": "internet", "source_ids": ["internet-mac-visible2025"], "tags": ["social", "chat"], "note": "轻松形容表现抢眼、存在感强；适合善意调侃。"},
    {"text": "小确幸", "pinyin": "xiao que xing", "category": "internet", "source_ids": ["internet-chat-self-2026"], "tags": ["self-care"], "note": "生活中细小、具体的愉快体验。"},
    {"text": "信息断舍离", "pinyin": "xin xi duan she li", "category": "internet", "source_ids": ["internet-mac-offline2026"], "tags": ["digital", "life"], "note": "主动减少过量信息输入，给生活留出空间。"},
    {"text": "已读乱回", "pinyin": "yi du luan hui", "category": "internet", "source_ids": ["internet-reply-2025"], "tags": ["chat"], "note": "形容看过消息后的答非所问或随意回复；收录词形，不鼓励敷衍交流。"},
    {"text": "硬控", "pinyin": "ying kong", "category": "internet", "source_ids": ["internet-chat-words-2024", "internet-mac-year2024"], "tags": ["chat", "digital", "reaction"], "note": "夸张表示某内容特别吸引人，让人挪不开注意力。"},
    {"text": "悦己", "pinyin": "yue ji", "category": "internet", "source_ids": ["internet-chat-self-2026"], "tags": ["self-care"], "note": "按自己的需要和喜好获得愉悦。"},
    {"text": "找搭子", "pinyin": "zhao da zi", "category": "internet", "source_ids": ["internet-chat-dazi-2024"], "tags": ["social"], "note": "寻找一起吃饭、运动、出游等的伙伴。"},
    {"text": "整活", "pinyin": "zheng huo", "category": "internet", "source_ids": ["internet-mac-create2025"], "tags": ["creation", "social"], "note": "用新奇或幽默的点子做有趣内容。"},
    {"text": "种草", "pinyin": "zhong cao", "category": "internet", "source_ids": ["internet-chat-travel-2025", "internet-mac-shopping2025"], "tags": ["recommendation", "shopping", "social"], "note": "分享推荐，或因此对商品、地点等产生兴趣。"},
    {"text": "主理人", "pinyin": "zhu li ren", "category": "internet", "source_ids": ["internet-chat-pandian-2024", "internet-mac-offline2026"], "tags": ["creation", "work"], "note": "常用于称呼店铺、民宿或创意品牌的经营负责人。"},
    {"text": "主体性", "pinyin": "zhu ti xing", "category": "internet", "source_ids": ["internet-youth-2026"], "tags": ["self-care"], "note": "讨论个人选择与独立思考时使用；属于持续使用的表达，不标为当年新造词。"},
    {"text": "自我关怀", "pinyin": "zi wo guan huai", "category": "internet", "source_ids": ["internet-youth-2026"], "tags": ["self-care"], "note": "谈论温和对待自己、照顾自身需要的表达。"},
    {"text": "嘴替", "pinyin": "zui ti", "category": "internet", "source_ids": ["internet-chat-language-2025", "internet-mac-voice2025"], "tags": ["chat", "reaction", "social"], "note": "替自己说出想法、准确表达共同心声的人。"}
